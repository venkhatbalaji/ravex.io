DATABASE_URL=postgresql://ravex:ravex_dev@localhost:5432/ravex
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Gemini API (Google AI Studio free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-flash-latest
# Caps Gemini 3's "thinking" tokens, which are billed as completion tokens and can
# dwarf the visible reply. 0 disables thinking on models that allow it.
GEMINI_THINKING_BUDGET=0

# reCAPTCHA v2 checkbox (https://www.google.com/recaptcha/admin — register a v2
# "I'm not a robot" checkbox site; add localhost as a domain for local dev).
# Protects sign-up and sign-in only — not chat, since a checkbox on every message
# would be too disruptive. Both keys must be set together: site key enables the
# client-side widget, secret key enables server-side enforcement. Leave both blank
# to disable — safe for local dev, NOT recommended for a public deployment.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Chat quota
CHAT_DAILY_TOKEN_QUOTA=20000
CHAT_MAX_OUTPUT_TOKENS=512
