{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3001", "http://localhost:3002" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "identity-me": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/me" }
      },
      "wallet": {
        "ClusterId": "wallet-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/wallet/{**catch-all}" }
      },
      "market-catalog-read": {
        "ClusterId": "market-catalog-cluster",
        "Match": { "Path": "/markets/{**catch-all}", "Methods": [ "GET" ] }
      },
      "market-catalog-write": {
        "ClusterId": "market-catalog-cluster",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/markets/{**catch-all}", "Methods": [ "POST" ] }
      },
      "categories-read": {
        "ClusterId": "market-catalog-cluster",
        "Match": { "Path": "/categories/{**catch-all}", "Methods": [ "GET" ] }
      },
      "categories-write": {
        "ClusterId": "market-catalog-cluster",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/categories/{**catch-all}", "Methods": [ "POST", "PUT", "DELETE" ] }
      },
      "branding-theme-read": {
        "ClusterId": "branding-cluster",
        "Match": { "Path": "/branding/theme", "Methods": [ "GET" ] }
      },
      "branding-theme-write": {
        "ClusterId": "branding-cluster",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/branding/theme", "Methods": [ "PUT" ] }
      },
      "branding-copy-read": {
        "ClusterId": "branding-cluster",
        "Match": { "Path": "/branding/copy", "Methods": [ "GET" ] }
      },
      "branding-copy-write": {
        "ClusterId": "branding-cluster",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/branding/copy/{**catch-all}", "Methods": [ "PUT", "DELETE" ] }
      },
      "settlement-write": {
        "ClusterId": "settlement-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/pools/{**catch-all}", "Methods": [ "POST" ] }
      },
      "prediction-history": {
        "ClusterId": "settlement-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/predictions/me", "Methods": [ "GET" ] }
      },
      "settlement-preview": {
        "ClusterId": "settlement-cluster",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/pools/{marketId}/settle", "Methods": [ "POST" ] },
        "Order": -10
      },
      "settlement-read": {
        "ClusterId": "settlement-cluster",
        "Match": { "Path": "/pools/{**catch-all}", "Methods": [ "GET" ] }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "d1": { "Address": "http://identity:8080" } }
      },
      "wallet-cluster": {
        "Destinations": { "d1": { "Address": "http://wallet-ledger:8080" } }
      },
      "market-catalog-cluster": {
        "Destinations": { "d1": { "Address": "http://market-catalog:8080" } }
      },
      "settlement-cluster": {
        "Destinations": { "d1": { "Address": "http://settlement-engine:8080" } }
      },
      "branding-cluster": {
        "Destinations": { "d1": { "Address": "http://branding:8080" } }
      }
    }
  }
}
