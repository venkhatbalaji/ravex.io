{
  "name": "ravex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ravex/web",
    "dev:platform": "npm run dev --workspace=@ravex/platform",
    "dev:admin": "npm run dev --workspace=@ravex/admin",
    "build": "npm run build --workspace=@ravex/web",
    "lint": "npm run lint --workspace=@ravex/web",
    "typecheck": "npm run typecheck --workspace=@ravex/web",
    "db:generate": "npm run db:generate --workspace=@ravex/web",
    "db:migrate": "npm run db:migrate --workspace=@ravex/web",
    "test:backend": "python3 services/tests/stake_lifecycle.py",
    "test:ui": "python3 services/tests/stake_lifecycle.py --ui",
    "test:all": "npm run typecheck --workspaces --if-present && npm run test:ui"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
